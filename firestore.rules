rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: the Firebase Auth uid of the owner
// Fields:
//   - email:       string (required, <= 320 chars, may be empty for providers without email)
//   - provider:    string (required, one of password | google.com | other)
//   - createdAt:   timestamp (required, == request.time on create, immutable)
//   - lastLoginAt: timestamp (required, == request.time on every write)
//   - displayName: string (optional, <= 100 chars)
//   - photoURL:    string (optional, <= 2048 chars, http/https URL)
//
// Contains PII (email), so only the owner may read it.
// All other paths are denied. Clients can never delete user documents.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidUrl(url) {
      return url is string && url.size() <= 2048 &&
        (url.matches('^https://.*') || url.matches('^http://.*'));
    }

    // ===============================================================
    // Domain Validators (used by BOTH create and update)
    // ===============================================================

    function isValidUser(data) {
      return hasRequiredFields(['email', 'provider', 'createdAt', 'lastLoginAt']) &&
        hasOnlyAllowedFields(['email', 'provider', 'createdAt', 'lastLoginAt', 'displayName', 'photoURL']) &&
        data.email is string && data.email.size() <= 320 &&
        data.provider is string && data.provider in ['password', 'google.com', 'other'] &&
        data.createdAt is timestamp &&
        data.lastLoginAt is timestamp && data.lastLoginAt == request.time &&
        (!('displayName' in data) ||
          (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || isValidUrl(data.photoURL));
    }

    // ===============================================================
    // users/{userId}
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
        isValidUser(request.resource.data) &&
        request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId) &&
        isValidUser(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
